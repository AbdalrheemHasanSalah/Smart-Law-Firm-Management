# backend/.env on the production server (/opt/qadiyati/backend/.env).
# setup-server.sh writes this file with the database password and auth secret already generated;
# fill in the rest by hand. Never copy your development .env here, and never share this file.
# NODE_ENV=production is set by the systemd service, not here.

PORT=3000
# Reachable only through nginx on this machine.
HOST=127.0.0.1
FRONTEND_URL=https://qadiyati.ps
TRUSTED_FRONTEND_ORIGINS=https://qadiyati.ps,https://www.qadiyati.ps
BETTER_AUTH_URL=https://qadiyati.ps
# Generated by setup-server.sh (64 random hex characters). Changing it signs everyone out.
BETTER_AUTH_SECRET=GENERATED

# nginx runs on this machine and passes the visitor's real address; count rate limits by it.
TRUST_PROXY=loopback

# Local PostgreSQL with its own non-superuser role (created by setup-server.sh).
DB_HOST=localhost
DB_PORT=5432
DB_USER=qadiyati
DB_PASSWORD=GENERATED
DB_NAME=qadiyati
DB_SSL=false

DOCUMENT_MAX_BYTES=10485760

# Email, free with no domain: a Gmail mailbox with an App Password (Google account > Security >
# 2-Step Verification > App passwords). When these three are set they are used ahead of Resend.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your.address@gmail.com
# SMTP_PASS=the 16-letter app password
# SMTP_FROM=قضيتي <your.address@gmail.com>

# Or email through Resend. MAIL_FROM must be on a domain that shows "Verified" in Resend.
RESEND_API_KEY=
MAIL_FROM=قضيتي <no-reply@qadiyati.ps>

# AI hearing preparation (optional). Gemini's free tier lets Google use the content: real client
# data needs a paid key (Claude or paid Gemini).
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Where offices pay the subscription. Use your REAL details here; each method appears only when set.
# PAYMENT_BANK_NAME=
# PAYMENT_BANK_ACCOUNT_NAME=
# PAYMENT_BANK_IBAN=
# PAYMENT_WALLET_NAME=
# PAYMENT_WALLET_ACCOUNT_NAME=
# PAYMENT_WALLET_NUMBER=
# PAYMENT_CASH_ADDRESS=
# PAYMENT_CASH_HOURS=

# SUBSCRIPTION_MONTHLY_PRICE=100
# SUBSCRIPTION_CURRENCY=ILS
# SUBSCRIPTION_TRIAL_DAYS=30

# AI allowance: analyses, AI drafts and AI hearing sheets per subscribed lawyer per month (40 when unset).
# AI_MONTHLY_ANALYSES_PER_LAWYER=40

# Push notifications (Web Push). Generate the keys once with: npx web-push generate-vapid-keys
# Without them push stays off and everything else works.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# Official notices on WhatsApp: the country code added to local numbers that start with 0 (970 when unset).
# WHATSAPP_DEFAULT_COUNTRY_CODE=970
