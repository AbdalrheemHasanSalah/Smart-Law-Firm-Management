{
  "name": "smart-law-firm-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --import ./test/setup.js --test test/session.test.js test/client.test.js test/case.test.js test/documents.test.js test/contracts.test.js test/caseNotes.test.js test/initializeConfig.test.js test/task.test.js test/securityConfig.test.js test/dbConfig.test.js test/originProtection.test.js test/user.test.js test/securityHeaders.test.js test/rateLimit.test.js test/errorHandler.test.js test/migrationRunner.test.js && npm run test:unit-isolation",
    "test:unit-isolation": "node --import ./test/unitTestIsolationSetup.js --test test/unitTestIsolation.test.js",
    "test:case-assignment-unit": "node --import ./test/caseAssignmentUnitSetup.js --test test/caseAssignment.service.test.js",
    "test:client-account-linking": "node --import ./test/setup.js --test test/clientAccountLinking.test.js",
    "test:integration": "node --test --test-concurrency=1 test/auth.integration.test.js test/userManagement.integration.test.js",
    "test:integration:auth": "node --test --test-concurrency=1 test/auth.integration.test.js",
    "test:integration:user-management": "node --test --test-concurrency=1 test/userManagement.integration.test.js",
    "test:integration:migrations": "node --test --test-concurrency=1 test/migrationRunner.integration.test.js",
    "test:integration:migrations:post-fence": "node --test --test-concurrency=1 test/migrationRunner.postFence.integration.test.js",
    "test:provision-admin": "node scripts/provisionTestAdmin.js",
    "db:init": "node database/initialize.js",
    "db:migrate": "node database/migrate.js --up",
    "db:migrate:status": "node database/migrate.js --status"
  },
  "dependencies": {
    "better-auth": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "kysely": "^0.28.2",
    "pg": "^8.13.1"
  }
}
