PORT=3000
FRONTEND_URL=http://localhost:5173
BETTER_AUTH_URL=http://localhost:3000
# Set ENFORCE_ORIGIN_PROTECTION=true in staging and any non-production
# environment containing real credentials or data. Production always enforces
# origin protection; local development may leave this unset.
ENFORCE_ORIGIN_PROTECTION=false
# In production, set HTTPS BETTER_AUTH_URL and one or more HTTPS frontend origins.
# TRUSTED_FRONTEND_ORIGINS=https://app.example.com,https://portal.example.com
# Required: use a cryptographically random secret with at least 32 characters.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Database configuration
DB_HOST=localhost
DB_PORT=5432
# This default is for local compatibility only. For persistent environments,
# use a separately provisioned non-superuser application role. Never use the
# PostgreSQL postgres superuser for integration tests or deployed applications.
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=smart_law_firm
# Remote PostgreSQL connections using discrete DB settings require DB_SSL=true
# in every environment; server certificates are verified.
# DB_SSL=false is intended only for supported local database connections.
# Maximum PDF upload size in bytes (default 10 MiB; maximum 50 MiB).
DOCUMENT_MAX_BYTES=10485760
# Integration tests require TEST_INTEGRATION_ENABLED=true, an explicit
# TEST_DATABASE_URL with an explicit port, TEST_DATABASE_NAME=smart_law_firm_test,
# TEST_DATABASE_ROLE matching the URL username, and exact host/server-address
# allowlists. Use a dedicated least-privilege, non-owner login; superuser,
# BYPASSRLS, CREATEDB, CREATEROLE, replication, role memberships, ownership,
# public-schema CREATE, and CONNECT to smart_law_firm are rejected.
# Only sslmode=verify-full and sslrootcert (with verify-full) URL parameters
# are accepted. Remote hosts require sslmode=verify-full. PGOPTIONS must be
# unset; PGSSLMODE must be unset or verify-full.
# Both integration suites require TEST_DATABASE_DISPOSABLE=true. This is only
# an operator attestation, not proof: a PostgreSQL administrator must verify
# the server, role attributes/memberships, database ACLs, ownership, and safe
# rebuildability independently before opting in.
# Test-admin provisioning is a separate write operation and additionally
# requires TEST_ADMIN_PROVISION_ENABLED=true after the same verification.
# TEST_INTEGRATION_ENABLED=false
# TEST_DATABASE_URL=<dedicated-test-database-url-with-explicit-port>
# TEST_DATABASE_NAME=smart_law_firm_test
# TEST_DATABASE_HOST_ALLOWLIST=localhost
# TEST_DATABASE_SERVER_ADDRESS_ALLOWLIST=127.0.0.1,::1
# TEST_DATABASE_ROLE=smart_law_firm_test_runner
# TEST_DATABASE_DISPOSABLE=false
# TEST_ADMIN_PROVISION_ENABLED=false
# TEST_ADMIN_EMAIL=<dedicated-test-admin-address>
# TEST_ADMIN_PASSWORD=<secret>
# TEST_BETTER_AUTH_SECRET=<secret-of-at-least-32-characters>
# Optional connection string alternative (URL-encode reserved characters):
# Supply a complete PostgreSQL connection URL here if using this setting.
# DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
# DB_SSL=false
